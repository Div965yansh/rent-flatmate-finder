# ------------------------------------------------------------------------------
# Rent & Flatmate Finder — Backend Production Environment Configuration
# ------------------------------------------------------------------------------
# NOTE: Never commit real credentials to version control.
# Copy this file to .env and provide your deployment-specific credentials.

# -----------------
# Core Application
# -----------------
# [MANDATORY] Environment mode ('production', 'development', or 'test')
NODE_ENV=production

# [OPTIONAL] Port on which the Express server listens (managed automatically on Render/Heroku)
PORT=5000

# [MANDATORY] Allowed frontend origins for CORS and Socket.io.
# Supports single URL (e.g., https://my-app.vercel.app) or comma-separated URLs
FRONTEND_URL=https://your-frontend-app.vercel.app

# -----------------
# Database (Prisma)
# -----------------
# [MANDATORY] Managed PostgreSQL connection URI (e.g., from Render PostgreSQL, Supabase, Neon)
# Ensure ?sslmode=require is appended for production managed databases
DATABASE_URL=postgresql://user:password@host:5432/database_name?sslmode=require

# -----------------
# Authentication
# -----------------
# [MANDATORY] High-entropy secret key for HMAC SHA-256 JWT signing (at least 32 characters)
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-32-chars

# [OPTIONAL] JWT lifetime duration (default: 7d)
JWT_EXPIRES_IN=7d

# -----------------
# Persistent Object Storage (Cloudinary)
# -----------------
# [MANDATORY in Production] Cloudinary credentials for persistent listing image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------
# AI / LLM Compatibility Analysis
# -----------------
# [OPTIONAL] LLM provider identifier (default: 'gemini')
LLM_PROVIDER=gemini

# [OPTIONAL] Gemini API Key for semantic listing compatibility (falls back safely to rule engine if missing)
GEMINI_API_KEY=your_gemini_api_key

# [OPTIONAL] Model identifier (default: 'gemini-1.5-flash')
GEMINI_MODEL=gemini-1.5-flash

# -----------------
# Transactional Email (Resend)
# -----------------
# [OPTIONAL] Email provider identifier (default: 'resend')
EMAIL_PROVIDER=resend

# [OPTIONAL] Resend API Key for transactional interest notifications (skips safely if missing)
RESEND_API_KEY=your_resend_api_key

# [OPTIONAL] Verified sender email address (default: 'Rent & Flatmate Finder <onboarding@resend.dev>')
EMAIL_FROM=Rent & Flatmate Finder <onboarding@resend.dev>

# -----------------
# Rate Limiting Overrides (Optional)
# -----------------
# RATE_LIMIT_GLOBAL_MAX=600
# RATE_LIMIT_AUTH_MAX=60
# RATE_LIMIT_COMPATIBILITY_MAX=100
# RATE_LIMIT_MESSAGES_MAX=120
