# ------------------------------------------------------------------------------
# Rent & Flatmate Finder — Frontend Production Environment Configuration
# ------------------------------------------------------------------------------
# In production, set these variables in your hosting provider's dashboard (e.g. Vercel).
# Do NOT embed secret keys into VITE_* variables as they are bundled into client assets.

# [MANDATORY in Production] Base URL pointing to deployed backend API
# Example: https://your-backend-app.onrender.com/api
VITE_API_URL=https://your-backend-app.onrender.com/api

# [MANDATORY in Production] Base URL pointing to deployed Socket.io server
# Example: https://your-backend-app.onrender.com
VITE_SOCKET_URL=https://your-backend-app.onrender.com
